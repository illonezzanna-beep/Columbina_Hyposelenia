{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/data.ts": {
      "maxDuration": 15,
      "memory": 1024
    },
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/data",
      "destination": "/api/data"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|data|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
