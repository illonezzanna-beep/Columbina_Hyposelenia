{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/data",
      "destination": "/api/data"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|data|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
